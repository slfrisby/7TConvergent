        <Param name="opacity" updates="constant" val="" valType="num"/>
        <Param name="ori" updates="constant" val="0" valType="num"/>
        <Param name="pos" updates="constant" val="(0, 0.15)" valType="list"/>
        <Param name="saveStartStop" updates="None" val="True" valType="bool"/>
        <Param name="startEstim" updates="None" val="" valType="code"/>
        <Param name="startType" updates="None" val="time (s)" valType="str"/>
        <Param name="startVal" updates="None" val="0.0" valType="code"/>
        <Param name="stopType" updates="None" val="duration (s)" valType="str"/>
        <Param name="stopVal" updates="constant" val="" valType="code"/>
        <Param name="syncScreenRefresh" updates="None" val="True" valType="bool"/>
        <Param name="text" updates="constant" val="Please name the pictures" valType="str"/>
        <Param name="units" updates="None" val="from exp settings" valType="str"/>
        <Param name="wrapWidth" updates="constant" val="" valType="num"/>
      </TextComponent>
      <KeyboardComponent name="key_resp">
        <Param name="allowedKeys" updates="constant" val="'space'" valType="list"/>
        <Param name="correctAns" updates="constant" val="" valType="str"/>
        <Param name="disabled" updates="None" val="False" valType="bool"/>
        <Param name="discard previous" updates="constant" val="True" valType="bool"/>
        <Param name="durationEstim" updates="None" val="" valType="code"/>
        <Param name="forceEndRoutine" updates="constant" val="True" valType="bool"/>
        <Param name="name" updates="None" val="key_resp" valType="code"/>
        <Param name="saveStartStop" updates="None" val="True" valType="bool"/>
        <Param name="startEstim" updates="None" val="" valType="code"/>
        <Param name="startType" updates="None" val="time (s)" valType="str"/>
        <Param name="startVal" updates="None" val="0.0" valType="code"/>
        <Param name="stopType" updates="None" val="duration (s)" valType="str"/>
        <Param name="stopVal" updates="constant" val="" valType="code"/>
        <Param name="store" updates="constant" val="last key" valType="str"/>
        <Param name="storeCorrect" updates="constant" val="False" valType="bool"/>
        <Param name="syncScreenRefresh" updates="constant" val="True" valType="bool"/>
      </KeyboardComponent>
    </Routine>
    <Routine name="setup">
      <CodeComponent name="code">
        <Param name="Before Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Before JS Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Begin Experiment" updates="constant" val="# setup&amp;#10;from psychopy import sound&amp;#10;import pandas as pd&amp;#10;import random&amp;#10;&amp;#10;## GENERATE PRESENTATION ORDER&amp;#10;# based on session number, choose order. These are generated by optseq - living = 0; nonliving = 1&amp;#10;# main runs&amp;#10;if expInfo[&quot;run&quot;] == &quot;1&quot;:&amp;#10;    optseqOrder = &quot;StimLists\optseqOrder1.xlsx&quot;&amp;#10;elif expInfo[&quot;run&quot;] == &quot;2&quot;:&amp;#10;    optseqOrder = &quot;StimLists\optseqOrder2.xlsx&quot;&amp;#10;elif expInfo[&quot;run&quot;] == &quot;3&quot;:&amp;#10;    optseqOrder = &quot;StimLists\optseqOrder3.xlsx&quot;&amp;#10;elif expInfo[&quot;run&quot;] == &quot;4&quot;:&amp;#10;    optseqOrder = &quot;StimLists\optseqOrder4.xlsx&quot;&amp;#10;# spare run of normal length - can use for training&amp;#10;elif expInfo[&quot;run&quot;] == &quot;5&quot;:&amp;#10;    optseqOrder = &quot;StimLists\optseqOrderSpare.xlsx&quot;&amp;#10;    &amp;#10;# load the order in&amp;#10;df = pd.read_excel(optseqOrder)&amp;#10;&amp;#10;# convert the order to boolean&amp;#10;animacyidx = df['ConditionOrder'].astype(bool).tolist()&amp;#10;&amp;#10;# scramble living and nonliving&amp;#10;living = random.sample(range(50), 50)&amp;#10;nonliving = random.sample(range(50, 100), 50)&amp;#10;&amp;#10;# initialise sequence and counters&amp;#10;sequence = [0] * 100&amp;#10;lividx = 0&amp;#10;nonlividx = 0&amp;#10;&amp;#10;# fill in the order&amp;#10;for i in range(len(animacyidx)):&amp;#10;    if animacyidx[i]:&amp;#10;        sequence[i] = nonliving[nonlividx]&amp;#10;        nonlividx += 1&amp;#10;    else:&amp;#10;        sequence[i] = living[lividx]&amp;#10;        lividx += 1&amp;#10;" valType="extendedCode"/>
        <Param name="Begin JS Experiment" updates="constant" val="fas;&amp;#10;" valType="extendedCode"/>
        <Param name="Begin JS Routine" updates="constant" val="" valType="extendedCode"/>
        <Param name="Begin Routine" updates="constant" val="" valType="extendedCode"/>
        <Param name="Code Type" updates="None" val="Py" valType="str"/>
        <Param name="Each Frame" updates="constant" val="" valType="extendedCode"/>
        <Param name="Each JS Frame" updates="constant" val="" valType="extendedCode"/>
        <Param name="End Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="End JS Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="End JS Routine" updates="constant" val="" valType="extendedCode"/>
        <Param name="End Routine" updates="constant" val="" valType="extendedCode"/>
        <Param name="disabled" updates="None" val="False" valType="bool"/>
        <Param name="name" updates="None" val="code" valType="code"/>
      </CodeComponent>
    </Routine>
